<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press menu of the app icon. Pinned notes are added at runtime (ExternalViews). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_note"
        android:shortcutId="new_note"
        android:shortcutLongLabel="@string/shortcut_new_note_long"
        android:shortcutShortLabel="@string/shortcut_new_note">
        <intent
            android:action="com.cenotes.app.NEW_NOTE"
            android:targetClass="com.cenotes.app.MainActivity"
            android:targetPackage="com.cenotes.app" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_list"
        android:shortcutId="new_list"
        android:shortcutLongLabel="@string/shortcut_new_list_long"
        android:shortcutShortLabel="@string/shortcut_new_list">
        <intent
            android:action="com.cenotes.app.NEW_LIST"
            android:targetClass="com.cenotes.app.MainActivity"
            android:targetPackage="com.cenotes.app" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutId="search"
        android:shortcutLongLabel="@string/shortcut_search_long"
        android:shortcutShortLabel="@string/shortcut_search">
        <intent
            android:action="com.cenotes.app.SEARCH"
            android:targetClass="com.cenotes.app.MainActivity"
            android:targetPackage="com.cenotes.app" />
    </shortcut>
</shortcuts>
