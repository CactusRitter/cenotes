<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Camera writes its photo here before it is imported. -->
    <cache-path name="camera" path="camera/" />
    <!-- Note images, shared together with the note text. -->
    <files-path name="images" path="images/" />
    <!-- A downloaded update, handed to Android's installer (Settings → Updates). -->
    <external-files-path name="updates" path="Download/" />
</paths>
